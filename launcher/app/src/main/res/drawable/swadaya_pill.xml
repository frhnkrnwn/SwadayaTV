<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pil Swadaya normal: hijau-abu gelap minimal -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1E2E24" />
            <corners android:radius="21dp" />
            <stroke android:width="1.2dp" android:color="#FF14E8A0" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF162019" />
            <corners android:radius="21dp" />
            <stroke android:width="1dp" android:color="#3314E8A0" />
        </shape>
    </item>
</selector>
