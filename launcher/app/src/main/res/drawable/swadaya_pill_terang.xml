<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pil Swadaya Terang: porselen cerah hijau-abu untuk siang -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FFE4EBE6" />
            <corners android:radius="21dp" />
            <stroke android:width="1.2dp" android:color="#FF2A4A3A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF0F4F1" />
            <corners android:radius="21dp" />
            <stroke android:width="1dp" android:color="#FFC8D6CC" />
        </shape>
    </item>
</selector>
